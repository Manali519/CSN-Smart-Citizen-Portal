# Backend environment variables.
# Local development: copy to backend/.env and fill in. Never commit .env.
# Production: add the same names under Vercel -> backend project -> Settings -> Environment Variables.

# ---------- Server ----------
PORT=5000
# Use production on Vercel (secure cookies, hidden error details)
NODE_ENV=development
# Frontend URL(s), comma-separated, no trailing slash. Production example: https://smart-city-portal.vercel.app
CLIENT_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API. Leave empty: defaults to 1 on Vercel, 0 locally.
TRUST_PROXY=
# Auth cookie SameSite: lax (default; the frontend proxies /api, so cookies are first-party), strict or none
COOKIE_SAMESITE=

# ---------- Database (MongoDB Atlas) ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ---------- Sessions ----------
# At least 32 characters in production (e.g. openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Google Sign-In ----------
# OAuth Web client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# ---------- SMTP for OTP emails (Gmail: use an App Password) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=Smart City Portal

# ---------- OTP ----------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Complaint validation: Google Gemini API ----------
# Free API key from https://aistudio.google.com/apikey
# Without it, complaints skip the AI check and go to the admin review queue.
GEMINI_API_KEY=
# Multimodal Gemini model (photo + text)
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=30000
# Minimum combined score for auto-routing, and the weights of the photo and description scores
AI_FUSION_THRESHOLD=0.6
AI_W_IMAGE=0.5
AI_W_TEXT=0.5

# ---------- Complaints ----------
# City bounding box "minLng,minLat,maxLng,maxLat" (default: Chhatrapati Sambhajinagar)
CITY_BBOX=75.20,19.78,75.50,19.98
DAILY_COMPLAINT_LIMIT=10
# Duplicate-photo threshold, 0-5 bits of perceptual-hash difference
DUP_HAMMING_MAX=5

# ---------- Complaint photos ----------
# Vercel Blob (public store). Added automatically when a Blob store is connected to the Vercel project.
# Leave empty locally: photos are saved to UPLOAD_DIR (default backend/uploads) and served at /uploads.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=

# ---------- Razorpay (optional, test keys only: rzp_test_...) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
