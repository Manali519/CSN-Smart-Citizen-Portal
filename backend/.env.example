# Copy to .env and fill in. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (0 when reached directly).
# Defaults to 1 on Cloud Run; 2 when the frontend's Vercel rewrite is also in front.
TRUST_PROXY=0
# Auth cookie SameSite (default lax). Use none only when the browser calls the API cross-site.
COOKIE_SAMESITE=

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Sessions (at least 32 characters in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth client ID only; ID tokens are verified server-side)
GOOGLE_CLIENT_ID=

# SMTP for OTP emails
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Smart City Portal

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Complaint validation (ml-service)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_API_KEY=
ML_TIMEOUT_MS=20000

# Complaints: city bounding box "minLng,minLat,maxLng,maxLat", daily limit, duplicate-photo threshold (0-5)
CITY_BBOX=75.20,19.78,75.50,19.98
DAILY_COMPLAINT_LIMIT=10
DUP_HAMMING_MAX=5
# Complaint photos: Cloud Storage bucket in production; when empty they are written to UPLOAD_DIR
# (default backend/uploads) and served at /uploads.
GCS_BUCKET=
UPLOAD_DIR=

# Razorpay (test mode keys only: rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
