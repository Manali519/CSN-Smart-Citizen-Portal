# Copy to deploy/cloudrun.env (git-ignored) and fill in. Read by deploy/cloudrun.sh.
# Quote values that contain & ; $ spaces or # (e.g. MONGODB_URI).

# Google Cloud
GCP_PROJECT=
GCP_REGION=asia-south1
# Defaults to <GCP_PROJECT>-complaint-photos
GCS_BUCKET=

# Vercel frontend URL (no trailing slash); comma-separate extra domains
FRONTEND_URL=https://your-app.vercel.app

# Shared secret between backend and ml-service (e.g. output of: openssl rand -hex 32)
ML_API_KEY=

# Backend
MONGODB_URI='mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority'
# At least 32 characters (e.g. output of: openssl rand -base64 48)
JWT_SECRET=
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail: an App Password, not the account password
SMTP_PASS=
# Optional: payments answer 503 until both are set
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
